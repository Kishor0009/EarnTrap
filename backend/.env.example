# =========================================================================
# EarnTrap Backend Environment Configuration Example
# Set these variables in Render dashboard under Environment Variables
# =========================================================================

# HTTP Server Port (Render sets this dynamically, defaults to 8080 locally)
PORT=8080

# TiDB Cloud MySQL Connection
# Preserves required SSL/TLS parameters: ?useSSL=true&requireSSL=true
DB_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/earntrap?useSSL=true&requireSSL=true
DB_USERNAME=your_tidb_username_here
DB_PASSWORD=your_tidb_password_here

# Frontend CORS Allowed Origins
# Specify comma-separated origins. Supports wildcards (e.g., https://*.vercel.app)
CORS_ALLOWED_ORIGINS=https://earntrap.vercel.app,http://localhost:5173

# JWT Authentication Secret Key (minimum 256-bit / 32 characters in production)
JWT_SECRET=your_production_secure_jwt_secret_key_at_least_32_chars_long

# Payment Gateway Configuration (Optional; defaults to SANDBOX mode)
PAYMENT_PROVIDER=SANDBOX
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
