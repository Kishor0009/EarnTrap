# EarnTrap Frontend Environment Variables

# Backend API base URL (Spring Boot deployed on Render)
# Can be specified with or without '/api' (client normalizes it automatically):
# e.g.: https://earntrap-backend.onrender.com
# or:   https://earntrap-backend.onrender.com/api
#
# In local development, leave unset or empty to use Vite's dev server proxy to http://localhost:8080.
VITE_API_BASE_URL=https://earntrap-backend.onrender.com/api
